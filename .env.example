# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Public (safe to expose; these ship in the browser bundle) ---
# Supabase now issues sb_publishable_... / sb_secret_... keys. The older
# eyJ... JWT anon/service_role keys still work, but new projects get these.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Base URL used to build auth callback links (email confirmation, password
# reset) in auth-actions.ts and partner-actions.ts. Falls back to VERCEL_URL,
# then localhost. MUST be the real domain in production or the links in those
# emails point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only ---
SUPABASE_URL=https://<project-ref>.supabase.co

# Required by adminClient() (src/integrations/supabase/admin-client.ts).
# Admin actions, the partner flow, Stripe, and public data fetch all throw
# without it. Bypasses RLS — a full-access credential. Never commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# --- Stripe (Founding Partner £150/month subscription) ---
STRIPE_SECRET_KEY=sk_test_...
# Signing secret for the /api/stripe/webhook endpoint (dashboard > Webhooks).
# This is per-endpoint: creating a new endpoint (new domain, new project)
# issues a new secret and the old one stops validating.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Zoho Mail SMTP). Optional — if SMTP_USER/SMTP_PASS unset, sends are skipped. ---
SMTP_HOST=smtp.zoho.eu           # or smtp.zoho.com — match where the account was created
SMTP_PORT=465                    # 465 = SSL, 587 = TLS
SMTP_USER=donot.reply@roadpantherperks.co.uk
# Prefer a Zoho *app-specific* password (Zoho Security > App Passwords) over the
# mailbox login password: it's scoped to SMTP, revocable on its own, and keeps
# working if 2FA is later enabled on the mailbox.
SMTP_PASS=<Zoho app-specific password>
# Zoho rejects sends whose From isn't the authenticated mailbox or a verified
# alias of it — keep this address matching SMTP_USER unless you've set up an alias.
EMAIL_FROM=Road Panther Perks <donot.reply@roadpantherperks.co.uk>
# Where "new signup" / "new partner application" alerts land. A monitored inbox,
# deliberately different from the no-reply sender above.
ADMIN_NOTIFY_EMAIL=hello@roadpantherperks.co.uk

# --- Not env vars: configure these in the Supabase dashboard ---
# The app's own SMTP (above) sends notification emails. Supabase Auth sends the
# "confirm your email" and password-reset links, and it has its OWN SMTP config
# that these variables do not feed. Set it per project:
#   Auth > SMTP Settings  — same Zoho host/port/user/pass as above
#   Auth > URL Configuration — Site URL + redirect URLs must match
#                              NEXT_PUBLIC_SITE_URL, or auth links break
# Until Auth > SMTP is set, new signups get no confirmation email.
